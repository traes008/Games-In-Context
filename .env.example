# Copy to .env and set only the credentials for the providers you use.
# Local Ollama evaluation does not require an API key.
# Google is the default provider for generating new scenarios.
GOOGLE_API_KEY=

# Optional providers, when added to EVAL_MODELS in src/config.py:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACEHUB_API_TOKEN=
